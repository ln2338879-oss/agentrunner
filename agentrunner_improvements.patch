+  if command -v gh >/dev/null 2>&1; then
+    gh pr create --title "feat(agent): apply ${TASK_ID}" \
+                 --body "Auto PR for approved task ${TASK_ID}\n\nReport: ${REPORT_PATH}\nReview: ${REVIEW_PATH}" \
