# AgentRunner all-in-one Office example
# Copy selected values into .env when running the built-in Office UI.

DATABASE_PATH=./data/agentrunner.sqlite

# Built-in AgentRunner Office
OFFICE_ENABLED=true
OFFICE_HOST=127.0.0.1
OFFICE_PORT=3000

# Optional access gate.
# Leave blank for localhost-only use.
# Set a long random value before exposing Office through a tunnel, reverse proxy, or non-local interface.
OFFICE_ACCESS_CODE=

# Optional legacy/dashboard API server
DASHBOARD_ENABLED=false
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787
